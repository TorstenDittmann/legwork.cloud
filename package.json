{
	"name": "legwork",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "wsu build",
		"dev": "bun --env-file=.env --bun wsu dev",
		"lint": "wsu run lint",
		"typecheck": "wsu run typecheck",
		"test": "vitest run --exclude packages/db/src/db.test.ts && bun x --bun vitest run packages/db/src/db.test.ts",
		"test:watch": "vitest",
		"db:generate": "bun run --filter @legwork/db generate",
		"db:migrate": "bun run --filter @legwork/db migrate",
		"db:tokens": "bun scripts/libsql-tokens.ts",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"check": "bun run lint && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@types/bun": "1.4.0",
		"@types/node": "22.18.0",
		"jose": "6.2.8",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"railway": "3.6.0",
		"typescript": "5.9.2",
		"vitest": "3.2.6",
		"workspace-utils": "2.1.0",
		"zod": "4.1.5"
	},
	"overrides": {
		"@esbuild-kit/core-utils>esbuild": "0.25.12"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"packageManager": "bun@1.3.14"
}
