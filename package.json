{
  "name": "on-call-ai",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": { "node": ">=22 <25" },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @oncall-ai/db generate",
    "db:migrate": "pnpm --filter @oncall-ai/db migrate",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.0",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "turbo": "2.10.8",
    "typescript": "5.9.2",
    "vitest": "3.2.6",
    "zod": "4.1.5"
  }
}
