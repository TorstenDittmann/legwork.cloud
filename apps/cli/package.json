{
	"name": "@legwork/cli",
	"version": "0.1.0",
	"private": true,
	"bin": {
		"legwork": "./dist/legwork.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "bun build src/index.ts --target=bun --outfile=dist/legwork.js",
