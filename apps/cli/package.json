		"test": "vitest run src"
	},
	"dependencies": {
		"@legwork/contracts": "workspace:*"
	},
	"devDependencies": {
		"typescript": "5.9.2",
		"vitest": "3.2.6"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
