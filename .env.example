# Worker
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
RAILWAY_TOKEN=
RAILWAY_ENVIRONMENT_ID=
SANDBOX_COMMAND_EXECUTION=false
SANDBOX_CAPABILITY_PROBE_PASSED=false
WORKER_CONCURRENCY=5
MAX_ORG_CONCURRENCY=2

# Notifications (worker only). Slack and Discord channels need nothing here;
# email channels stay unsendable until a Resend domain is verified.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
