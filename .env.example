# Shared
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
APP_URL=http://localhost:5173
DATA_ENCRYPTION_KEY=
LOG_LEVEL=info

# Web / WorkOS AuthKit
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback

# Web observability. /api/metrics returns 404 until this bearer token is set;
# configure the same value in your Prometheus scrape config.
METRICS_TOKEN=

# Billing (web only). Create matching recurring products in Dodo Payments.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:5173/checkout/success
DODO_PAYMENTS_TEAM_MONTHLY_PRODUCT_ID=
DODO_PAYMENTS_TEAM_ANNUAL_PRODUCT_ID=
DODO_PAYMENTS_SCALE_MONTHLY_PRODUCT_ID=
DODO_PAYMENTS_SCALE_ANNUAL_PRODUCT_ID=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_STATE_SECRET=

# Worker
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# Sandbox runtime: `railway` (default until the cutover), `sbx` or `docker`.
SANDBOX_PROVIDER=railway
# Railway provider only.
RAILWAY_TOKEN=
RAILWAY_ENVIRONMENT_ID=
# sbx provider only. Use a sandbox-scoped key; creating the analysis template needs an
# admin key once (`bun run --filter @legwork/sandbox sbx:template`).
SBX_URL=
SBX_API_KEY=
# Docker provider only. Repository commands run only under gVisor (`runsc`); any
# other runtime keeps run_check unavailable regardless of the flags below.
SANDBOX_DOCKER_RUNTIME=runsc
SANDBOX_IMAGE=legwork-sandbox:local
SANDBOX_COMMAND_EXECUTION=false
SANDBOX_CAPABILITY_PROBE_PASSED=false
WORKER_CONCURRENCY=5
# How long a draining worker waits for in-flight jobs before releasing their
# leases (milliseconds).
SHUTDOWN_GRACE_MS=25000

# Notifications (worker only). Slack and Discord channels need nothing here;
# email channels stay unsendable until a Resend domain is verified.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
